{
  "name": "qirei-claude-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Thin process around the Claude Agent SDK; speaks the Qirei sidecar protocol over stdin and stdout.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "bindings": "node scripts/copy-bindings.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=30000 'dist/test/**/*.test.js'",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "0.137.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
